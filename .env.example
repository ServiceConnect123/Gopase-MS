# URL del Google Apps Script (misma que usa goPase)
SCRIPT_URL=https://script.google.com/macros/s/AKfycbz1Zj2JaqQ3tnyytEA_Lr2AZxE1qnkeQdrWF3kG-58saNslmwHGv73PuCd0RnQSkFnkvg/exec

# Puerto del microservicio
PORT=3001

# Cron: cada 5 minutos por defecto
CRON_EXPRESSION=*/5 * * * *

# Ejecutar el chequeo también al arrancar el servicio (true/false)
RUN_ON_STARTUP=true

# URL que se muestra al admin en el mensaje para aprobar pagos (frontend PRD)
APP_APPROVAL_PATH=https://www.gopasehome.site/app/payments

# Estado que se considera "pendiente" en la hoja de pagos (dato_6)
PENDING_STATUS=Pendiente

# Hoja de Google Sheets donde Baileys persiste la sesión de WhatsApp.
# Debe existir en el Spreadsheet y estar registrada en el SHEET_MAP del Apps Script.
WHATSAPP_SESSION_SHEET=wsp_session

# Timeout por petición al Apps Script (ms). Subir si la sesión es grande/lenta.
SHEETS_TIMEOUT_MS=40000

# Reintentos con backoff para lecturas y operaciones idempotentes.
SHEETS_MAX_RETRIES=2

# Pausa entre mensajes de WhatsApp al notificar deudores (ms), para no ser
# bloqueado por WhatsApp. Por defecto 4 segundos.
WHATSAPP_MESSAGE_DELAY_MS=4000

# Orígenes permitidos para CORS (separados por coma). Si se deja vacío, se usan
# los dominios conocidos de goPase. Ej:
# CORS_ORIGINS=https://www.gopasehome.site,https://gopasehome.site
CORS_ORIGINS=

# ==========================================================================
# Firebase Admin (Realtime Database) - sincronización Sheets -> RTDB
# ==========================================================================
# URL del Realtime Database del proyecto (QA usa gopaseqa, PRD usa gopase).
#   QA:  https://gopaseqa-default-rtdb.firebaseio.com
#   PRD: https://gopase-default-rtdb.europe-west1.firebasedatabase.app
FIREBASE_DATABASE_URL=

# Credenciales de la service account. Usa UNA de estas opciones:
#
# Opción 1 (recomendada en Render): el JSON completo de la service account en
# una sola variable. Pega el contenido del archivo .json descargado de
# Firebase (Configuración del proyecto -> Cuentas de servicio -> Generar clave).
FIREBASE_SERVICE_ACCOUNT=
#
# Opción 2: los tres campos por separado (en FIREBASE_PRIVATE_KEY, deja los
# saltos de línea como \n; el código los normaliza).
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Token opcional para proteger los endpoints /sync (header x-sync-token).
# Si se deja vacío, los endpoints quedan abiertos (solo para pruebas).
SYNC_TOKEN=

# ==========================================================================
# Migración a Firebase Auth (estrategia A1: username -> email sintético)
# ==========================================================================
# Dominio del email sintético con el que se crean los usuarios en Firebase Auth.
# No se envían correos; es solo el identificador interno (uid = username).
# Por defecto: gopase.local
AUTH_EMAIL_DOMAIN=gopase.local
